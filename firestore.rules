rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userGroupId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId;
    }

    function memberDocExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupMember(groupId) {
      return signedIn() &&
        memberDocExists(groupId) &&
        userGroupId() == groupId;
    }

    function isGroupOwner(groupId) {
      return isGroupMember(groupId) &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    function isTaskCreator() {
      return resource.data.createdBy == request.auth.uid;
    }

    function onlyTaskStatusKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'updatedAt', 'completedBy', 'reminderAt']);
    }

    function canChangeTaskStatus() {
      return isTaskCreator() ||
        resource.data.isGroupTask == true ||
        resource.data.assigneeId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || (
        signedIn() &&
        resource.data.groupId != null &&
        isGroupMember(resource.data.groupId)
      );
      allow create, update: if isSelf(userId);
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if emailVerified();
      allow update, delete: if isGroupOwner(groupId);
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);

      match /members/{memberId} {
        allow read: if signedIn();
        allow create: if emailVerified() && memberId == request.auth.uid;
        allow update, delete: if isGroupOwner(groupId) || isSelf(memberId);
      }

      match /tasks/{taskId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId);
        allow update: if isGroupMember(groupId) && (
          isTaskCreator() ||
          (onlyTaskStatusKeys() && canChangeTaskStatus())
        );
        allow delete: if isGroupMember(groupId) && (
          isTaskCreator() || isGroupOwner(groupId)
        );
      }
    }

    match /users/{userId}/tasks/{taskId} {
      allow read, write: if isSelf(userId);
      // Owner may return a member's own tasks when they leave / are removed.
      allow create: if request.resource.data.createdBy == userId &&
        get(/databases/$(database)/documents/users/$(userId)).data.groupId != null &&
        isGroupOwner(get(/databases/$(database)/documents/users/$(userId)).data.groupId);
    }

    match /invites/{inviteId} {
      // Join reads a specific code document (id == code). No collection list.
      allow get: if emailVerified();
      allow list: if signedIn() && resource.data.invitedBy == request.auth.uid;
      allow create: if emailVerified() &&
        request.resource.data.inviteCode == inviteId &&
        request.resource.data.invitedBy == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if (
        resource.data.invitedBy == request.auth.uid
      ) || (
        emailVerified() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.acceptedBy == request.auth.uid &&
        request.resource.data.inviteCode == resource.data.inviteCode &&
        request.resource.data.groupId == resource.data.groupId &&
        request.resource.data.invitedBy == resource.data.invitedBy
      );
      allow delete: if resource.data.invitedBy == request.auth.uid;
    }
  }
}
